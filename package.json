{
  "name": "chalksmith",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "validator": "tsx packages/core/scripts/build-validator.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json && npm run check -w @chalksmith/desktop",
    "fixtures": "tsx packages/core/fixtures/generate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
